# Public base URL used inside generated QR codes (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional locally. When set, stores are read from Neon instead of data/stores.json.
DATABASE_URL=

# Admin login. With DATABASE_URL, seed the user with `npm run seed:admin`.
# Without DATABASE_URL, these credentials are used for local development.
ADMIN_ID=
ADMIN_PASSWORD=
AUTH_SECRET=

# Server-side AI credentials. Never expose these with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
